#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 2>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 5>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            bindings = <
&kp GRAVE  &kp N1   &kp N2  &kp N3   &kp N4         &kp N5            &kp N6     &kp N7     &kp N8     &kp N9   &kp N0         &kp MINUS
&kp ESC    &kp Q    &kp W   &kp F    &kp P          &kp G             &kp J      &kp L      &kp U      &kp Y    &kp SEMICOLON  &kp BSLH
&kp TAB    &kp A    &kp R   &lt 3 S  &kp T          &kp D             &kp H      &kp N      &kp E      &kp I    &kp O          &kp APOS
&kp LCTRL  &lt 4 Z  &kp X   &kp C    &kp V          &lt 5 B           &kp K      &kp M      &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                            &kp DEL  &kp BACKSPACE  &kp LEFT_SHIFT    &kp ENTER  &kp SPACE
                                     &kp LEFT_GUI   &mo 1             &mo 2
            >;
        };

        Num {
            bindings = <
&trans  &kp F1        &kp F2        &kp F3     &kp F4          &kp F5             &kp F6            &kp F7           &kp F8           &kp F9           &kp F10            &none
&trans  &trans        &trans        &trans     &kp DELETE      &trans             &kp LEFT_BRACKET  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp RIGHT_BRACKET  &none
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &mt LG(L) LG(L)    &kp KP_PLUS       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS       &kp EQUAL
&trans  &trans        &trans        &trans     &kp INSERT      &trans             &kp KP_ASTERISK   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SLASH       &kp KP_DOT
                                    &trans     &trans          &trans             &kp KP_DOT        &kp KP_N0
                                               &trans          &trans             &kp KP_ENTER
            >;
        };

        Nav {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6        &kp F7  &kp F8    &kp F9        &kp F10    &kp F11  &kp F12
&trans  &none   &none   &none   &none   &trans        &none   &none     &kp UP_ARROW  &none      &none    &none
&trans  &none   &none   &none   &none   &trans        &none   &kp LEFT  &kp DOWN      &kp RIGHT  &none    &trans
&trans  &trans  &trans  &trans  &trans  &none         &none   &none     &trans        &trans     &none    &trans
                        &trans  &trans  &To0_macro    &none   &none
                                &trans  &trans        &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans     &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LCTRL  &kp LEFT_SHIFT  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mo 3   &trans     &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &mkp MB2   &mkp MB1        &mkp MB3    &trans  &trans
                                   &trans          &trans      &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };
    };
};
